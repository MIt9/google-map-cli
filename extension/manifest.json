{
  "manifest_version": 3,
  "name": "Google Maps CLI Bridge",
  "version": "0.1.31",
  "description": "Connects the local Google Maps CLI service to a background Maps tab.",
  "permissions": ["tabs", "scripting", "alarms", "storage"],
  "host_permissions": ["https://www.google.com/*", "https://consent.google.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Google Maps CLI Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "key": ""
}
